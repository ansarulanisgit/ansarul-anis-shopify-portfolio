# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Role Key (Never expose to client bundle!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend API Key for Contact Form Notifications
RESEND_API_KEY=re_your_resend_api_key

# Contact Form Recipient Email
CONTACT_NOTIFICATION_EMAIL=your-email@example.com

# On-Demand ISR Revalidation Secret Token
REVALIDATE_SECRET_TOKEN=your_custom_secret_token_here

# Site URL for canonical metadata and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000
